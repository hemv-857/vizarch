// vizarch — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// vizarch: saved diagrams (for share links)
model Diagram {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String?
  description String
  graphJson   String   // serialized ArchGraph { nodes, edges }
  styleJson   String?  // optional style overrides
  svgCache    String?  // optional pre-rendered SVG
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    DiagramVersion[]

  @@index([slug])
}

// vizarch: version history for diagrams (tracks revisions)
model DiagramVersion {
  id          String   @id @default(cuid())
  diagramId   String
  version     Int      // version number (1, 2, 3...)
  graphJson   String   // snapshot of graph at this version
  styleJson   String?
  svgCache    String?
  changeSummary String? // optional: what changed
  createdAt   DateTime @default(now())
  diagram     Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId])
}

// vizarch: node annotations/comments (for collaboration)
model NodeAnnotation {
  id          String   @id @default(cuid())
  diagramSlug String   // which diagram this annotation belongs to
  nodeId      String   // which node in the graph
  author      String   // anonymous by default (e.g. "Anonymous")
  text        String   // comment text
  createdAt   DateTime @default(now())

  @@index([diagramSlug, nodeId])
}

// vizarch: rate limit counters (persisted across server restarts)
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique  // ip:endpoint:tier
  count       Int      @default(0)
  windowStart DateTime @default(now())
  tier        String   @default("free")

  @@index([key])
}
