# vizarch — Environment variables

# Database (SQLite by default)
DATABASE_URL=file:./dev.db

# API key for write endpoints (optional — if set, POST/DELETE require X-Api-Key header)
VIZARCH_API_KEY=

# Slack integration (optional — for /vizarch slash command)
SLACK_SIGNING_SECRET=

# LLM provider (z-ai-web-dev-sdk / Claude API)
# See z-ai-web-dev-sdk docs for configuration
